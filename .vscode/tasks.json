{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "tests",
            "type": "shell",
            "command": "cargo build -p tests",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "build-flutter-windows-debug",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/flutter/covert_connect_ui"
            },
            "command": "flutter build windows --debug",
            "problemMatcher": []
        },
        {
            "label": "copy-pdb",
            "type": "shell",
            "command": "copy ${workspaceFolder}/flutter/covert_connect_ui/build/windows/x64/plugins/rust_lib_covert_connect/Debug/rust_lib_covert_connect.pdb ${workspaceFolder}/flutter/covert_connect_ui/build/windows/x64/runner/Debug/rust_lib_covert_connect.pdb",
            "problemMatcher": []
        },
        {
            "label": "prerun-windows",
            "dependsOrder": "sequence",
            "dependsOn": [
                "build-flutter-windows-debug",
                "copy-pdb"
            ]
        }        
    ]
}